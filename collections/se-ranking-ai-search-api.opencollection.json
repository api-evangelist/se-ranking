{
  "opencollection": "1.0.0",
  "info": {
    "name": "SE Ranking Data Account & system AI search API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "AI search",
        "type": "folder"
      },
      "items": [
