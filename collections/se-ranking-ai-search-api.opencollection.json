              {
                "name": "apikey",
                "value": "{{secret_key_data}}",
                "type": "query"
              },
              {
                "name": "target",
                "value": "seranking.com",
                "type": "query"
              },
              {
                "name": "source",
                "value": "us",
                "type": "query"
              },
              {
                "name": "engine",
                "value": "ai-overview",
                "type": "query"
              },
              {
                "name": "brand",
                "value": "SE Ranking",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "base_domain",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves a high-level summary of a domain’s key performance metrics and historical trends within a specified LLM."
        },
        {
          "info": {
            "name": "leaderboard",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.seranking.com/v1/ai-search/overview/leaderboard",
            "params": [
              {
                "name": "apikey",
                "value": "{{secret_key_data}}",
                "type": "query"
              },
              {
                "name": "brand",
                "value": "SE Ranking",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "base_domain",
                "type": "query"
