              },
              {
                "name": "offset",
                "value": "0",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "100",
                "type": "query"
              },
              {
                "name": "filter[multi_keyword_included]",
                "value": "[\n [\n {\n \"type\": \"contains\",\n \"value\": \"seo\"\n }\n ]\n]",
                "type": "query"
              },
              {
                "name": "filter[multi_keyword_excluded]",
                "value": "[\n  [\n    { \"type\": \"contains\", \"value\": \"seo\"   },\n    { \"type\": \"contains\", \"value\": \"tools\" }\n  ],\n  [\n    { \"type\": \"contains\", \"value\": \"backlinks\" }\n  ]\n]",
                "type": "query"
              },
              {
                "name": "filter[volume][from]",
                "value": "100",
                "type": "query"
              },
              {
                "name": "filter[volume][to]",
                "value": "100000",
                "type": "query"
              },
              {
                "name": "filter[keyword_count][from]",
                "value": "5",
                "type": "query"
              },
              {
                "name": "filter[keyword_count][to]",
                "value": "8",
                "type": "query"
              },
              {
                "name": "filter[characters_count][from]",
                "value": "15",
                "type": "query"
              },
              {
                "name": "filter[characters_count][to]",
                "value": "50",
                "type": "query"
              }
            ]
          },
          "docs": "Fetches a list of prompts where a specified domain, subdomain, or URL appears in the results of a chosen LLM."
        },
        {
