          },
          "http": {
            "method": "GET",
            "url": "https://api.seranking.com/v1/ai-search/overview/aggregated/time-series",
            "params": [
              {
                "name": "target",
                "value": "seranking.com",
                "type": "query"
              },
              {
                "name": "source",
                "value": "us",
                "type": "query"
              },
              {
                "name": "brand",
                "value": "SE Ranking",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "base_domain",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves a high-level aggregated summary of a domain's key performance metrics and historical trends across all LLM engines."
        },
        {
          "info": {
            "name": "overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seranking.com/v1/ai-search/overview/by-engine/time-series",
