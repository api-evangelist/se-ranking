{
  "opencollection": "1.0.0",
  "info": {
    "name": "SE Ranking Data Account & system Domain Analysis API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Domain Analysis",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Regional database",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seranking.com/v1/domain/overview/db",
            "params": [
              {
                "name": "apikey",
                "value": "{{secret_key_data}}",
                "type": "query"
              },
              {
                "name": "source",
                "value": "us",
                "type": "query"
              },
              {
                "name": "domain",
                "value": "seranking.com",
                "type": "query"
              },
              {
                "name": "url",
                "value": "https://seranking.com/api.html",
                "type": "query"
              },
              {
                "name": "with_subdomains",
                "value": "false",
                "type": "query"
              }
            ]
          },
          "docs": "Provides a detailed breakdown of a domain's organic and paid keyword performance within a single specified regional database."
        },
        {
          "info": {
            "name": "Worldwide aggregate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seranking.com/v1/domain/overview/worldwide",
            "params": [
              {
                "name": "apikey",
                "value": "{{secret_key_data}}",
                "type": "query"
              },
              {
                "name": "domain",
                "value": "seranking.com",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "price,traffic,keywords,positions_diff,positions_tops",
                "type": "query"
              },
              {
                "name": "show_zones_list",
                "value": "0",
                "type": "query"
              },
              {
                "name": "currency",
                "value": "USD",
                "type": "query",
                "description": "ISO 4217 currency code."
              },
              {
                "name": "with_subdomains",
                "value": "true",
                "type": "query"
              }
            ]
          },
          "docs": "Aggregates a domain’s current global search performance statistics for both organic and paid traffic."
        },
        {
          "info": {
            "name": "Worldwide aggregate for URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seranking.com/v1/domain/overview/worldwide/url",
            "params": [
              {
                "name": "apikey",
                "value": "{{secret_key_data}}",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "price,traffic,keywords",
                "type": "query"
              },
              {
                "name": "url",
                "value": "https://seranking.com/api.html",
                "type": "query"
              }
            ]
          },
          "docs": "Aggregates a domain’s current global search performance statistics for both organic and paid traffic."
        },
